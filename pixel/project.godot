; DELVE — pixel build (GDD-06 §4.2, GDD-07 §5)
;
; Engine configuration for the 480x270 pixel shell: boot sequence + game menu.
; This project is self-contained under `pixel/` and shares no code or assets with
; the retired web shell at the repository root or the old 3D blockout under
; `godot/`.
;
; Keys follow GDD-06 §4.2 exactly:
;   viewport 480x270 · stretch=viewport · aspect=keep · scale_mode=integer
;   nearest texture filtering · 2D transform/vertex snapping
;   gl_compatibility renderer (WebGL2, required for the web export)
;   bitmap fonts rasterised with no antialiasing, hinting or subpixel placement

config_version=5

[application]

config/name="DELVE — Pixel Build"
config/description="DELVE pixel build: boot sequence and game menu. Unofficial, non-commercial fan project."
config/version="0.4.0-pixel"
run/main_scene="res://scenes/ui/shell.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/pixel/ui/icon.png"

[autoload]

; Order matters: data layers first, then state, then services that read state.
Palette="*res://scripts/core/palette.gd"
Brand="*res://scripts/core/brand.gd"
ShellData="*res://scripts/core/shell_data.gd"
GameState="*res://scripts/core/game_state.gd"
SaveStore="*res://scripts/core/save_store.gd"
Streams="*res://scripts/core/rng_streams.gd"
Dice="*res://scripts/core/dice.gd"
Sound="*res://scripts/core/sound.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

; 0 = None / Disabled on the TextServer enums: bitmap fonts stay crisp.
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0
theme/default_font_hinting=0

[input]

; Mirror of scripts/core/input_actions.gd, which re-adds anything missing at
; boot. Keep the two in step when bindings change.
menu_up={
