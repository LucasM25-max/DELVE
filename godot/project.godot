; DELVE — native Godot port. Open with Godot 4.7.2 standard (GDScript).
config_version=5

[application]
config/name="DELVE"
config/version="0.1.0-godot"
run/main_scene="res://scenes/ui/shell.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/description="DELVE menu shell and optional 3D blockout. Unofficial, non-commercial fan project."

[autoload]
GameState="*res://scripts/core/game_state.gd"
Sound="*res://scripts/core/sound.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.055, 0.065, 1)

[audio]
driver/enable_input=false
