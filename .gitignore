# Godot caches / exports are rebuilt locally.
godot/.godot/
godot/exports/

# Packaging / scratch artifacts (binaries belong in GitHub Releases — GDD-06 T-03).
*.zip
deliverables/
__pycache__/
*.pyc
*.tmp

# Pixel build (pixel/): engine cache, exports and audio.
# Audio lands cue by cue via `python3 pixel/tools/fetch_audio.py` — the tracks
# already exist elsewhere in the repo, so they are not duplicated into Git.
pixel/.godot/
pixel/exports/
pixel/assets/audio/
pixel/preview/
